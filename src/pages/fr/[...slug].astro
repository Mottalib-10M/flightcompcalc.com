---
/** Chaque page de contenu (src/content/pages), version fr. */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/pages';
import type { PageDef } from '../../lib/page-types';
export function getStaticPaths() {
  return PAGES.filter((p) => p.fr && p.fr.slug !== '').map((page) => ({ params: { slug: page.fr!.slug }, props: { page } }));
}
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="fr" />
