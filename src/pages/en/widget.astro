---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route, homeOf } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/flight-compensation/" title="Flight delay compensation calculator (embeddable)" width="100%" height="900" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title={'Embed the flight compensation calculator on your site'} description={'Travel blogs and forums can embed the flight delay and cancellation compensation calculator in one line of code: free, no cookie, results under EU261, UK261 and APPR.'} lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: homeOf(lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. The embedded calculator follows every update of the law.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>The calculator runs in your readers’ browsers and sends no data to us or to you. Please keep the link under it: it is how readers find the sources and the method.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/flight-compensation/" title="Flight delay compensation calculator (embeddable)" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
