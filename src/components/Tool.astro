---
/** Le calculateur d'une page. */
import FlightCalc from './calc/FlightCalc';
import SmallTools from './calc/SmallTools';
import { route, type Locale } from '../i18n/routes';
import type { ToolArg } from '../lib/tool-types';
interface Props { kind: string; lang: Locale; arg?: ToolArg; idPrefix?: string }
const { kind, lang, arg, idPrefix = 't' } = Astro.props;
const a = arg ? JSON.stringify(arg) : undefined;
const methodHref = route('method', lang);
---
{kind === 'flight'
  ? <FlightCalc client:load lang={lang} arg={a} methodHref={methodHref} idPrefix={idPrefix} />
  : <SmallTools client:load kind={kind as 'rail'} lang={lang} arg={a} methodHref={methodHref} idPrefix={idPrefix} />}
